<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>False</PublishAot>
	<IsAotCompatible>True</IsAotCompatible>
    <InvariantGlobalization>True</InvariantGlobalization>
	<StripSymbols>False</StripSymbols>
    <StartupObject>EU.CqrXs.Console.Program</StartupObject>
    <ApplicationIcon>ConsoleIcon.ico</ApplicationIcon>
    <PublishTrimmed>True</PublishTrimmed>
    <Title>EU.CqrXs.Console</Title>
    <Description>EU.CqrXs.Console</Description>
    <Copyright>Copyright © 2000-2040 Copyleft https://cqrxs.eu</Copyright>
    <PackageProjectUrl>https://cqrxs.eu/download/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/heinrichelsigan/CryptPipe/</RepositoryUrl>
    <AssemblyVersion>2.26.724</AssemblyVersion>
    <FileVersion>2.26.724</FileVersion>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <WarningLevel>9999</WarningLevel>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <WarningLevel>9999</WarningLevel>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="README.MD">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ConsoleIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.Platforms" Version="8.0.0-preview.7.23375.6" />
    <PackageReference Include="Microsoft.NETCore.Targets" Version="6.0.0-preview.4.21253.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EU.CqrXs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Console_Test.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="README.MD">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
